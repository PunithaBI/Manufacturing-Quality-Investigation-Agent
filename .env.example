APP_NAME=manufacturing-quality-investigation-agent
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./data/Northwind_db/nordwind.db

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

CONFIDENCE_THRESHOLD=0.90
MAX_TOOL_CALLS=12
MAX_RETRIEVAL_RESULTS=20
MAX_CONTEXT_TOKENS=12000

ALLOW_WRITE_TOOLS=false
REQUIRE_HITL_FOR_HIGH_IMPACT=true

VECTOR_TOP_K=10
KEYWORD_TOP_K=10
GRAPH_MAX_HOPS=3

ENABLE_TRACING=true
ENABLE_AUDIT=true
